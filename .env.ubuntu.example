# Пример .env файла для Ubuntu Server
# Скопируйте этот файл в .env и измените значения

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="ИЗМЕНИТЕ_НА_БЕЗОПАСНЫЙ_ПАРОЛЬ"
POSTGRES_DB="plane"
PGDATA="/var/lib/postgresql/data"

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="ИЗМЕНИТЕ_НА_БЕЗОПАСНЫЙ_ПАРОЛЬ"
RABBITMQ_VHOST="plane"

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# AWS Settings (MinIO для локального хранения файлов)
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880

# LLM для генерации отчётов
# Получите ключ на https://platform.deepseek.com/api_keys (DeepSeek)
# или https://platform.openai.com/api-keys (OpenAI)
SKIP_ENV_VAR=0
LLM_API_KEY=ВСТАВЬТЕ_ВАШ_DEEPSEEK_ИЛИ_OPENAI_КЛЮЧ
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# Для OpenAI используйте:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Settings related to Docker
DOCKERIZED=1
USE_MINIO=1

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"
